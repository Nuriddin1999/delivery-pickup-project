# Copy this file to .env and change what you need. .env is not committed.

# ---- Backend (Go) ----
# Paths are relative to backend/, where `go run .` is started.
SERVER_ADDR=:8080
DATA_FILE=../data/data.json
REGIONS_FILE=../data/regions.geojson
# Folder with the built page (frontend/dist) to serve from the Go server. Empty = API only.
STATIC_DIR=

# ---- Frontend (Vite) ----
# Where the dev server (npm run dev) forwards /api. Not sent to the browser.
API_PROXY_TARGET=http://localhost:8080
# Only VITE_* variables reach the page.
VITE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
VITE_MAP_ZOOM=12

# ---- Docker ----
# Port on your machine for `docker compose up`.
APP_PORT=8080
